;;;; init.lisp.example — Limn v0.27+ user configuration demo.
;;;;
;;;; Copy to:
;;;;   ~/.limn/init.lisp                (most users)
;;;;   $LIMN_INIT                       (explicit override)
;;;;   /tmp/.limn/init.lisp             (dev fallback)
;;;;
;;;; Demonstrates the v0.27+ config API:
;;;;   - which-key popup after a prefix key
;;;;   - leader-key bindings via map!
;;;;   - recent-file list via recentf

(in-package :cl-user)

;;; ── which-key ──────────────────────────────────────────────────────────────
;;; Show available key hints after a prefix.  Call once to enable.
(limn/which-key:which-key-mode)

;;; ── leader-key bindings (default leader: SPC) ─────────────────────────────
;;;
;;; (map! :leader KEY FN ...) binds into *leader-keymap*.
;;; Use multiple pairs in one call or call map! multiple times.
(limn/map-macro:map! :leader
  "f f" #'limn/file:find-file
  "f s" #'limn/file:save-buffer)

;;; ── recent files ───────────────────────────────────────────────────────────
;;; Restore *recentf-list* from ~/.limn/recentf on startup.
;;; No-op when the file is absent.
(limn/recentf:recentf-load)

;;; ── logging verbosity ──────────────────────────────────────────────────────
;;; Limn writes every framework log line to the *messages* buffer (see
;;; `buffer/text :buffer-id "*messages*"` or the Lisp ring via
;;; `(limn/log:get-records)`).  Verbosity is hierarchical: namespaces are
;;; dotted symbols and inherit from their parent, with `*default-log-level*`
;;; as the root fallback.
;;;
;;; Examples (commented — uncomment to taste):
;;;
;;;   (setf limn/log:*default-log-level* :warn)        ; quiet everything
;;;   (limn/log:set-level 'pdf-mode :debug)            ; loud pdf-mode subtree
;;;   (limn/log:set-level 'pdf-mode.annotation :info)  ; quieter just for annot
;;;   (limn/log:unset-level 'pdf-mode)                 ; inherit from default

(format t ";; init.lisp loaded: which-key, leader SPC f f/s, recentf~%")
