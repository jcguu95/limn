result

# Top-level vendored Lisp deps (local checkout, e.g. cl-ppcre) — not tracked.
/vendor/

# ── sioyek vendor tree ────────────────────────────────────────────────────────
# Track sioyek/pdf_viewer/ source files + top-level .pro/.qrc.
# Exclude vendored libs, generated Qt artifacts, and build output.

# Vendored libraries (too large / not our code)
sioyek/mupdf/
sioyek/zlib/
sioyek/android/
sioyek/windows_runtime/

# Sioyek's own VCS dotfiles (reference submodules we don't have)
sioyek/.gitattributes
sioyek/.gitignore
sioyek/.gitmodules
# tutorial.pdf is TRACKED (embedded into binary via resources.qrc).

# Qt-generated and build artifacts
sioyek/*.o
sioyek/pdf_viewer/*.o
sioyek/moc_*.cpp
sioyek/moc_predefs.h
sioyek/qrc_resources.cpp
sioyek/sioyek.app/
sioyek/limn.app/
sioyek/.qmake.stash

# Sioyek top-level non-source files
sioyek/bak/
# fzf/ is vendored upstream-sioyek C source (~1.4K LOC fuzzy matcher).
# Tracked in git so every fresh clone / worktree / docker build context
# is self-sufficient. (Pre-v0.37 it was gitignored, which broke docker
# builds from any worktree that didn't manually copy fzf in.)
sioyek/.github/
sioyek/scripts/
sioyek/data/
sioyek/icons/
sioyek/tutorial/
sioyek/resources/
# begin.png + end.png + tutorial.pdf + pdf_viewer/shaders/ are now TRACKED.
# They're embedded into the binary via resources.qrc — the build literally
# can't link without them. v0.37 unbroke fresh-clone/worktree builds.
sioyek/CMakeLists.txt
sioyek/Makefile
sioyek/LICENSE
sioyek/README.md
sioyek/last_version.txt
sioyek/*.sh
sioyek/*.py
sioyek/*.bat
sioyek/result

# Binary assets inside pdf_viewer/. shaders/ is TRACKED (qrc-embedded into
# binary, build dies without it). fonts/ + .ico stay untracked — fonts come
# from fontconfig at runtime, .ico is mac-icon-only and not in the Linux
# build path. v0.37 unbroke fresh-clone/worktree builds.
sioyek/pdf_viewer/fonts/
sioyek/pdf_viewer/icon1.ico
sioyek/pdf_viewer/icon2.ico

# Config/key files (user-facing runtime data, not source)
sioyek/pdf_viewer/*.config
sioyek/pdf_viewer/data/
sioyek/pdf_viewer/diff/

# _* files: original sioyek files preserved aside when we removed/replaced them
# (tracked — the rename from file.cpp → _file.cpp shows the removal intent)

# runtime REPL log
limn-repl.log
.claude/
