;;;; W11 — annotation + bookmark 混合
(in-package :cl-user)
(require :sb-posix) (require :sb-bsd-sockets)
(defparameter *bdir* (or (sb-posix:getenv "LIMN_BACKEND_DIR") "/limn/backend/"))
(load (concatenate 'string *bdir* "tests/e2e/load-limn-system.lisp"))
(defun xdotool (&rest args) (zerop (sb-ext:process-exit-code (sb-ext:run-program "xdotool" args :search t :wait t :output nil :error nil))))
(defun wait-for-window (n) (let ((d (+ (get-universal-time) 5))) (loop (when (zerop (sb-ext:process-exit-code (sb-ext:run-program "xdotool" (list "search" "--name" n) :search t :wait t :output nil))) (return t)) (when (> (get-universal-time) d) (return nil)) (sleep 0.1))))
(ensure-directories-exist "/host-tmp/receipts/11/")
(defparameter *results* nil)
(defun check (l ok &optional (d "")) (push (cons l ok) *results*) (format t "  ~a ~a~a~%" (if ok "✓" "✗") l (if (string= d "") "" (format nil "   [~a]" d))))
(defun safe-call (cmd &rest args) (handler-case (cons :ok (limn/bridge:response-data (apply #'limn:call cmd args))) (error (e) (cons :err e))))
(defun overlay-count () (let ((r (safe-call "view/get" :|win-id| "w1"))) (and (eq (car r) :ok) (length (or (getf (cdr r) :|overlays|) '())))))
(defun key (k &optional (s 0.3)) (xdotool "key" "--clearmodifiers" k) (sleep s))
(defun mksel (p y0 y1) (safe-call "view/selection-set" :|win-id| "w1" :|begin| (list :|page| p :|x| 0.2 :|y| y0) :|end| (list :|page| p :|x| 0.6 :|y| y1)) (sleep 0.2))

(format t "~%── W11 annotation + bookmark 混合 ──~%")

(let* ((sock (format nil "/tmp/limn-w11-~a" (sb-posix:getpid))) (limn-bin "/limn/sioyek/limn")
       (proc (sb-ext:run-program limn-bin (list "--test-mode" "--socket" sock) :wait nil :search nil :output "/tmp/limn-w11.log" :if-output-exists :supersede :error :output)))
  (declare (ignore proc))
  (loop repeat 100 until (probe-file sock) do (sleep 0.05))
  (limn:start sock) (wait-for-window "Limn") (sleep 0.5)
  (xdotool "search" "--name" "Limn" "windowactivate") (sleep 0.3)

  (let* ((r (safe-call "bridge/engine-load" :|engine| "mupdf" :|path| "/limn/sioyek/tutorial.pdf" :|win-id| "w1"))
         (bid (and (eq (car r) :ok) (getf (cdr r) :|buffer-id|))))
    (sleep 0.5)
    ;; page 0: 2 highlights
    (safe-call "view/set" :|win-id| "w1" :|page| 0) (sleep 0.2)
    (mksel 0 0.20 0.25) (key "h")
    (mksel 0 0.30 0.35) (key "h")
    ;; page 3: 1 highlight + bookmark
    (safe-call "view/set" :|win-id| "w1" :|page| 3) (sleep 0.3)
    (mksel 3 0.20 0.25) (key "h")
    (let ((r (handler-case (limn/pdf-mode:pdf-set-bookmark-name bid "k" 3) (error (e) (cons :err e)))))
      (check "A.1 bookmark k set at page 3"
             (not (and (consp r) (eq (car r) :err)))
             (format nil "~a" r)))
    (let ((c (overlay-count)))
      (check "A.2 3 highlights total" (and (numberp c) (>= c 3))
             (format nil "overlays=~a" c)))
    ;; Close + reopen (within process)
    (safe-call "buffer/close" :|win-id| "w1") (sleep 0.3)
    (safe-call "bridge/engine-load" :|engine| "mupdf" :|path| "/limn/sioyek/tutorial.pdf" :|win-id| "w1") (sleep 0.8)
    ;; Verify overlays preserved
    (let ((c (overlay-count)))
      (check "A.3 reopen still has 3 overlays" (and (numberp c) (>= c 3))
             (format nil "overlays=~a" c)))
    ;; Jump bookmark k
    (let* ((rv (safe-call "view/get" :|win-id| "w1"))
           (new-bid (and (eq (car rv) :ok) (getf (cdr rv) :|buffer-id|))))
      (handler-case (limn/pdf-mode:pdf-jump-bookmark-name new-bid "k") (error () nil))
      (sleep 0.3)
      (let* ((rv (safe-call "view/get" :|win-id| "w1"))
             (p (and (eq (car rv) :ok) (getf (cdr rv) :|page|))))
        (check "A.4 'k jumps to page 3" (and (numberp p) (= p 3))
               (format nil "page=~a" p)))))
  (ignore-errors (sb-ext:run-program "pkill" '("-9" "-f" "/limn/sioyek/limn") :search t :wait t)))
(let* ((rev (reverse *results*)) (pass (count-if #'cdr rev)) (total (length rev)))
  (format t "~%── W11 result: ~a / ~a pass ──~%" pass total)
  (sb-ext:exit :code (if (= pass total) 0 1)))
